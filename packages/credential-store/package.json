  "files": ["dist"],
  "scripts": { "build": "tsup", "prepack": "pnpm run build", "test": "vitest run", "typecheck": "tsc --noEmit" },
  "dependencies": { "@napi-rs/keyring": "^1.3.0" },
  "devDependencies": { "@types/node": "^26.4.0", "@vitest/coverage-v8": "catalog:", "tsup": "^8.5.0", "typescript": "catalog:", "vitest": "catalog:" },
  "publishConfig": { "access": "public", "provenance": true }
}
