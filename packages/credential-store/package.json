{
  "name": "@getdomovoi/credential-store",
  "version": "0.0.1",
  "description": "Explicit keychain or private-file custody for Domovoi credentials.",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/getdomovoi/domovoi.git", "directory": "packages/credential-store" },
  "homepage": "https://domovoi.sh",
  "bugs": { "url": "https://github.com/getdomovoi/domovoi/issues" },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./package.json": "./package.json"
