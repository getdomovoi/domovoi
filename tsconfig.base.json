{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@getdomovoi/daemon": ["./apps/daemon/src/public.ts"],
      "@getdomovoi/daemon/internal": ["./apps/daemon/src/internal.ts"],
      "@getdomovoi/credential-store": ["./packages/credential-store/src/index.ts"],
      "@getdomovoi/protocol": ["./packages/protocol/src/index.ts"],
      "@getdomovoi/protocol/relay": ["./packages/protocol/relay/index.ts"],
      "@getdomovoi/protocol/relay-admission": ["./packages/protocol/relay-admission/index.ts"],
      "@getdomovoi/ui": ["./packages/ui/src/index.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "verbatimModuleSyntax": true
  }
}
