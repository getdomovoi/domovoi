{
  "name": "@getdomovoi/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "predev": "pnpm --filter @getdomovoi/protocol build && pnpm --filter @getdomovoi/daemon build",
    "pretest:launch": "pnpm --filter @getdomovoi/protocol build && pnpm --filter @getdomovoi/daemon build",
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:launch": "node --test scripts/launch-smoke-args.node.mjs && electron-vite build && node scripts/launch-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@getdomovoi/daemon": "workspace:*",
    "@getdomovoi/ui": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "44.0.0",
    "electron-vite": "^4.0.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
