{
  "name": "@getdomovoi/cli",
  "version": "0.0.1",
  "description": "Terminal client for a Domovoi daemon.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdomovoi/domovoi.git",
    "directory": "apps/cli"
  },
  "homepage": "https://domovoi.sh",
  "bugs": {
    "url": "https://github.com/getdomovoi/domovoi/issues"
  },
  "bin": {
    "domovoi": "./dist/index.js"
  },
  "files": [
    "dist/*.js"
  ],
  "scripts": {
    "build": "tsup",
    "predev": "pnpm --filter @getdomovoi/protocol build",
    "dev": "tsx src/index.ts",
    "pretest": "pnpm --filter @getdomovoi/protocol build && pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@getdomovoi/credential-store": "workspace:*",
    "@getdomovoi/protocol": "workspace:*",
    "@napi-rs/keyring": "^1.3.0",
    "ws": "^8.18.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
