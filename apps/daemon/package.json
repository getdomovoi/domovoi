{
  "name": "@getdomovoi/daemon",
  "version": "0.0.1",
  "description": "Execution daemon for Domovoi agent sessions.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdomovoi/domovoi.git",
    "directory": "apps/daemon"
  },
  "homepage": "https://domovoi.sh",
  "bugs": {
    "url": "https://github.com/getdomovoi/domovoi/issues"
  },
  "bin": {
    "domovoid": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    },
    "./internal": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": ["dist/*.js", "dist/*.d.ts"],
  "scripts": {
    "build": "tsup",
    "predev": "pnpm --filter @getdomovoi/protocol build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "pretest": "pnpm --filter @getdomovoi/protocol build && pnpm build",
    "test": "vitest run && pnpm test:dist",
    "test:dist": "pnpm build && node test-dist.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@anthropic-ai/sdk": "^0.121.0",
    "@getdomovoi/protocol": "workspace:*",
    "@kilocode/sdk": "7.5.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^1.3.0",
    "@opencode-ai/sdk": "^1.18.25",
    "node-pty": "1.2.0-beta.15",
    "parse5": "^8.0.1",
    "ws": "^8.18.3",
    "yaml": "^2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
