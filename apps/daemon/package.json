{
  "name": "@getdomovoi/daemon",
  "version": "0.0.1",
  "description": "Execution daemon for Domovoi agent sessions.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdomovoi/domovoi.git",
    "directory": "apps/daemon"
  },
  "homepage": "https://domovoi.sh",
  "bin": {
    "domovoid": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "predev": "pnpm --filter @getdomovoi/protocol build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "pretest": "pnpm --filter @getdomovoi/protocol build",
    "test": "vitest run && pnpm test:dist",
    "test:dist": "pnpm build && node test-dist.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.247",
    "@getdomovoi/protocol": "workspace:*",
    "@kilocode/sdk": "7.4.23",
    "@opencode-ai/sdk": "^1.18.23",
    "node-pty": "1.2.0-beta.15",
    "parse5": "^8.0.1",
    "ws": "^8.18.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
