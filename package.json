{
  "name": "@getdomovoi/root",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "predev": "pnpm --filter @getdomovoi/protocol build",
    "dev": "pnpm --parallel --filter @getdomovoi/daemon --filter @getdomovoi/web dev",
    "dev:desktop": "pnpm --filter @getdomovoi/desktop dev",
    "lint": "pnpm -r --if-present lint",
    "pretest": "pnpm --filter @getdomovoi/protocol build",
    "test": "pnpm --filter @getdomovoi/protocol test && pnpm --filter @getdomovoi/ui test && pnpm --filter @getdomovoi/daemon test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
