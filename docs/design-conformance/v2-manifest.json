        "apps/desktop/src/**/*.{ts,tsx}",
        "packages/ui/src/**/*.{ts,tsx}"
      ]
    },
    {
      "id": "desktop",
      "design": "design/design_handoff_domovoi_v2/designs/Domovoi Desktop V2.dc.html",
      "inventory": "docs/design-conformance/desktop-v2.json",
      "sources": [
